{
  "name": "@gluon/gluon",
  "version": "2.5.3",
  "description": "A tiny base class for Web Components, rendered with lite-html",
  "main": "./dist/gluon.js",
  "types": "./dist/gluon.d.ts",
  "unpkg": "dist/gluon.min.js",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruphin/gluonjs.git"
  },
  "author": "Goffert van Gool <ruphin@ruphin.net>",
  "keywords": [
    "web-components",
    "webcomponents",
    "lite-html",
    "custom-elements"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/ruphin/gluonjs/issues"
  },
  "scripts": {
    "dev": "vite examples",
    "build": "vite build && vite build --mode bundle && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build && npm test",
    "release": "np"
  },
  "homepage": "https://github.com/ruphin/gluonjs",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/gluon.d.ts",
      "default": "./dist/gluon.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "lite-html": "file:../lite-html"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "np": "4.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
