{
  "name": "@gluon/gluon",
  "version": "2.5.3",
  "description": "A tiny WebComponent library",
  "main": "gluon.js",
  "umd:main": "gluon.umd.js",
  "module": "gluon.js",
  "jsnext:main": "gluon.js",
  "files": [
    "gluon.*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruphin/gluonjs.git"
  },
  "author": "Goffert van Gool <ruphin@ruphin.net>",
  "keywords": [
    "web-components",
    "webcomponents",
    "lit-html",
    "lit"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/ruphin/gluonjs/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode umd",
    "test": "vitest run",
    "guard": "vitest",
    "prepublishOnly": "npm run build",
    "release": "np"
  },
  "homepage": "https://github.com/ruphin/gluonjs",
  "dependencies": {
    "lit-html": "1.0.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "np": "4.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
